{
  "name": "minas-agente",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "db:migrar": "tsx --env-file-if-exists=.env src/db/migrar.ts",
    "catalogo:importar": "tsx --env-file-if-exists=.env src/catalogo/cli.ts",
    "db:seed": "tsx --env-file-if-exists=.env src/db/semear.ts",
    "catalogo:fitment": "tsx --env-file-if-exists=.env src/catalogo/rodar-fitment.ts",
    "test:busca": "vitest run tests/busca/recall.test.ts",
    "test:aceite": "vitest run --config vitest.aceite.config.ts",
    "start": "tsx --env-file-if-exists=.env src/gateway/servidor.ts",
    "dev": "tsx watch --env-file-if-exists=.env src/gateway/servidor.ts",
    "agente:conversar": "tsx --env-file-if-exists=.env src/agente/cli.ts",
    "painel": "tsx --env-file-if-exists=.env src/painel/servidor.ts",
    "relatorio:diario": "tsx --env-file-if-exists=.env src/relatorio/diario.ts",
    "whatsapp:parear": "tsx --env-file-if-exists=.env src/whatsapp/parear.ts",
    "whatsapp:estado": "tsx --env-file-if-exists=.env src/whatsapp/estado.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.120.0",
    "fastify": "^5.12.1",
    "fflate": "^0.8.2",
    "pg": "^8.13.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
