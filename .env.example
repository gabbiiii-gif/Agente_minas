# Produção: Supabase pelo shared pooler (IPv4). Projeto iajsbmnzpjuprasssvcl.
# A conexão direta db.PROJETO.supabase.co só atende IPv6 e falha em rede residencial.
DATABASE_URL=postgresql://postgres.iajsbmnzpjuprasssvcl:SENHA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres

# Testes que escrevem: Postgres local descartável (docker compose -f docker-compose.teste.yml up -d)
TEST_DATABASE_URL=postgresql://postgres:teste@localhost:5433/postgres

# Chave da API Anthropic — extração de fitment, agente e gateway
ANTHROPIC_API_KEY=sk-ant-...

# Evolution API (VPS)
EVOLUTION_URL=http://localhost:8080
EVOLUTION_API_KEY=troque-esta-chave
EVOLUTION_INSTANCIA=minas

# Numero do dono, para relatorio e alerta de falha. E.164, sem +.
TELEFONE_DONO=93991106818

# Porta do gateway que recebe o webhook
PORTA=3000

# Segredo que o Evolution manda no header x-webhook-segredo; sem ele o
# gateway recusa a requisicao com 401.
WEBHOOK_SEGREDO=troque-este-segredo

# Painel: senha de acesso e segredo que assina o cookie de sessão.
# Sem os dois o painel se recusa a subir — ele mostra conversa de cliente.
PAINEL_SENHA=troque-esta-senha
PAINEL_SEGREDO=gere-um-valor-longo-e-aleatorio

# O painel também usa EVOLUTION_URL, EVOLUTION_API_KEY e EVOLUTION_INSTANCIA,
# declaradas acima: são elas que fazem a aba WhatsApp mostrar o estado da
# conexão, gerar o QR para trocar de número e responder cliente pelo balcão.
# Sem elas o painel sobe e funciona; só essa aba fica dizendo que o Evolution
# não está configurado. Se o painel rodar na Vercel, as três precisam estar
# nas variáveis do projeto lá também.

# Transcrição do áudio que o cliente manda no WhatsApp.
#
# O Claude lê texto, imagem e PDF, mas não escuta áudio — então a mensagem de
# voz precisa virar texto antes de chegar ao agente, e isso exige um provedor
# à parte. O padrão é a API de transcrição da OpenAI (Whisper), que cobra por
# minuto de áudio e trata português bem.
#
# Sem esta chave o sistema segue funcionando: o áudio é gravado no histórico
# e a conversa vai direto para o balcão, com um aviso ao cliente. O que não
# acontece mais, de um jeito ou de outro, é o cliente mandar áudio e não
# receber resposta nenhuma.
#
# Precisa estar também nos secrets da Edge Function, que é quem atende o
# webhook: npx supabase secrets set TRANSCRICAO_API_KEY=...
TRANSCRICAO_API_KEY=sk-proj-...

# Opcionais. Servem para trocar de modelo ou apontar a um serviço compatível
# com a API da OpenAI sem mexer em código.
# TRANSCRICAO_MODELO=whisper-1
# TRANSCRICAO_URL=https://api.openai.com/v1/audio/transcriptions
